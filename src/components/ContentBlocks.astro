---
import type { ContentBlock } from "../lib/content";
import { htmlWithBase, withBase } from "../lib/paths";

interface Props {
  blocks: ContentBlock[];
  skipFirstImage?: boolean;
}

const { blocks, skipFirstImage = false } = Astro.props;
let skipped = false;
const visibleBlocks = blocks.filter((block) => {
  if (skipFirstImage && !skipped && block.type === "image") {
    skipped = true;
    return false;
  }
  return true;
});
---

<div class="content-blocks">
  {
    visibleBlocks.map((block) =>
      block.type === "image" ? (
        <figure>
          <img src={withBase(block.src)} alt={block.alt} loading="lazy" />
          {block.alt && <figcaption>{block.alt}</figcaption>}
        </figure>
      ) : (
        <div class="prose" set:html={htmlWithBase(block.html)} />
      ),
    )
  }
</div>
